# Configurações do Servidor
GWIBOT_HOST=127.0.0.1
GWIBOT_PORT=8000

# Execução do Playwright (true para execução em segundo plano, false para abrir navegador)
GWIBOT_HEADLESS=true
GWIBOT_NAV_TIMEOUT_MS=25000
GWIBOT_SEL_TIMEOUT_MS=12000
GWIBOT_PAGE_DELAY_MS=700
GWIBOT_LOGIN_TIMEOUT_SEC=300

# Persistência de Dados (Opcional, padrão: data/gwibot.db)
# GWIBOT_DB_PATH=data/gwibot.db
